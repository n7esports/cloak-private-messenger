# UQZERA client environment — copy to .env.local and fill in.
# NEVER commit real values; .env.local and .env.production are gitignored.

# Supabase project. Required by the custom alias/PIN authentication routes.
# Keep the service-role key server-side only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# HMAC signing secret for the 8-hour HTTP-only app session cookie.
# Generate with: openssl rand -base64 48
# Use a unique random value of at least 32 bytes. Never commit the real secret.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Optional: self-hosted ws relay URL (server/src/index.js).
NEXT_PUBLIC_RELAY_URL=ws://localhost:8080
